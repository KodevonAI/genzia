# Postgres connection (Neon).
# Neon Console -> Project -> Connection Details -> pooled connection string,
# transaction mode (required: RLS session GUCs in lib/tenant/with-tenant-context.ts
# are set transaction-local via set_config(..., true), which depends on the pooler
# giving each transaction a clean session).
DATABASE_URL=

# Clerk (agency staff auth, org = agency).
# Clerk Dashboard -> API Keys.
# Also requires: Clerk Dashboard -> Organizations Settings -> Enable Organizations
# (off by default on new Clerk applications; Genzia maps one Clerk Organization
# to one agency tenant).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk webhook signing secret (svix), used by Plan 02 to sync org/user events
# into the `agencies` / `team_members` tables.
# Clerk Dashboard -> Webhooks -> your endpoint -> Signing Secret.
CLERK_WEBHOOK_SECRET=

# Cloudflare R2 (Plan 03: agent brand logo upload, CTA-02). S3-compatible
# object storage — first use in this project; the full asset library
# (Phase 12, SIS-04) builds on the same lib/storage/r2-client.ts.
# Cloudflare Dashboard -> R2 -> Overview (account id) -> Manage API Tokens
# (create a token scoped to the bucket below; access key + secret are shown
# once, at creation).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The bucket created for Genzia's assets (e.g. genzia-assets).
R2_BUCKET_NAME=
# Public base URL the bucket serves reads from — either R2's own public dev
# URL (Cloudflare Dashboard -> R2 -> bucket -> Settings -> Public Access ->
# "Enable" the r2.dev subdomain) or a custom domain mapped to the bucket.
# No trailing slash.
R2_PUBLIC_URL=

# Meta / WhatsApp Cloud API (Phase 3, WA-01/WA-03). Genzia is a direct Tech
# Provider — no BSP. While Meta's business verification is still pending
# (D-02), these point at Meta's free developer test WABA.
#
# App secret, used to verify the X-Hub-Signature-256 HMAC on every inbound
# webhook: developers.facebook.com -> your App -> App Settings -> Basic ->
# App Secret (click "Show").
META_APP_SECRET=

# A random string you choose. Meta echoes it back once, during the GET
# verification handshake. Paste the SAME value into
# developers.facebook.com -> WhatsApp -> Configuration -> Webhook ->
# "Verify token" when you register the callback URL.
META_WEBHOOK_VERIFY_TOKEN=

# The shared internal platform number (WA-03) — the one number every
# agency's team members write to. Team-internal messages arriving here are
# attributed to an agency by looking up the SENDER's registration
# (find_agency_by_team_whatsapp_number, migration 0013), never by the number
# they wrote to (WA-04).
# developers.facebook.com -> WhatsApp -> API Setup -> "Phone number ID".
META_WHATSAPP_PHONE_NUMBER_ID=

# Long-lived System User token, NOT the 24-hour token the API Setup
# quickstart page shows (RESEARCH.md Pitfall 4: sends start returning 401
# about a day later with no code change). Business Settings -> Users ->
# System Users -> create/select user -> Add Assets (the WABA) -> Generate
# new token with the `whatsapp_business_messaging` permission.
META_WHATSAPP_ACCESS_TOKEN=

# JSON map of { "<phone_number_id>": "<agency_id>" } for numbers that belong
# to ONE specific agency (a client-facing number). Optional; may be left
# empty or unset.
# This is the temporary platform-side stand-in for what WA-02's Embedded
# Signup will persist in the database once Meta approves Genzia's business
# verification (D-03 defers the Embedded Signup UI, not the routing seam).
# Example: {"123456789012345":"org_2abcDEF"}
META_AGENCY_PHONE_NUMBER_MAP=

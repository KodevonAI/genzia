# Postgres connection (Neon).
# Neon Console -> Project -> Connection Details -> pooled connection string,
# transaction mode (required: RLS session GUCs in lib/tenant/with-tenant-context.ts
# are set transaction-local via set_config(..., true), which depends on the pooler
# giving each transaction a clean session).
DATABASE_URL=

# Clerk (agency staff auth, org = agency).
# Clerk Dashboard -> API Keys.
# Also requires: Clerk Dashboard -> Organizations Settings -> Enable Organizations
# (off by default on new Clerk applications; Genzia maps one Clerk Organization
# to one agency tenant).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk webhook signing secret (svix), used by Plan 02 to sync org/user events
# into the `agencies` / `team_members` tables.
# Clerk Dashboard -> Webhooks -> your endpoint -> Signing Secret.
CLERK_WEBHOOK_SECRET=

# Cloudflare R2 (Plan 03: agent brand logo upload, CTA-02). S3-compatible
# object storage — first use in this project; the full asset library
# (Phase 12, SIS-04) builds on the same lib/storage/r2-client.ts.
# Cloudflare Dashboard -> R2 -> Overview (account id) -> Manage API Tokens
# (create a token scoped to the bucket below; access key + secret are shown
# once, at creation).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The bucket created for Genzia's assets (e.g. genzia-assets).
R2_BUCKET_NAME=
# Public base URL the bucket serves reads from — either R2's own public dev
# URL (Cloudflare Dashboard -> R2 -> bucket -> Settings -> Public Access ->
# "Enable" the r2.dev subdomain) or a custom domain mapped to the bucket.
# No trailing slash.
R2_PUBLIC_URL=

# Postgres connection (Neon).
# Neon Console -> Project -> Connection Details -> pooled connection string,
# transaction mode (required: RLS session GUCs in lib/tenant/with-tenant-context.ts
# are set transaction-local via set_config(..., true), which depends on the pooler
# giving each transaction a clean session).
DATABASE_URL=

# Clerk (agency staff auth, org = agency).
# Clerk Dashboard -> API Keys.
# Also requires: Clerk Dashboard -> Organizations Settings -> Enable Organizations
# (off by default on new Clerk applications; Genzia maps one Clerk Organization
# to one agency tenant).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk webhook signing secret (svix), used by Plan 02 to sync org/user events
# into the `agencies` / `team_members` tables.
# Clerk Dashboard -> Webhooks -> your endpoint -> Signing Secret.
CLERK_WEBHOOK_SECRET=
